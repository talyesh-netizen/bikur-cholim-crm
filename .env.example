# Copy this file to .env.local and fill in real values there.
# .env.local is intentionally ignored by Git (see .gitignore) — it should
# never be committed, emailed, or pasted into chat, because it contains
# credentials for the real database.
#
# Where to find these values: once a Supabase project exists, they are on
# the project's Settings > API page in the Supabase dashboard.

# The web address of the Supabase project. Safe to be visible in the
# browser (that's what "PUBLIC" means here) — it does not grant access by
# itself.
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" (anonymous) public API key for the Supabase project. Also
# safe to be visible in the browser. Access is controlled separately by
# who is signed in and the database's row-level security rules — not by
# keeping this key secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service role" key. This one is NOT safe to expose — it bypasses
# all row-level security rules. It must only ever be used in server-side
# code (never sent to the browser), and only once we build a feature that
# specifically needs it (for example, the CSV import process). Leave this
# blank until that stage.
SUPABASE_SERVICE_ROLE_KEY=
