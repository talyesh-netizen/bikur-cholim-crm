# Copy this file to .env.local and fill in real values there.
# .env.local is intentionally ignored by Git (see .gitignore) — it should
# never be committed, emailed, or pasted into chat, because it contains
# credentials for the real database.
#
# Where to find these values: once a Supabase project exists, they are on
# the project's Settings > API page in the Supabase dashboard.

# The web address of the Supabase project. Safe to be visible in the
# browser (that's what "PUBLIC" means here) — it does not grant access by
# itself.
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" (anonymous) public API key for the Supabase project. Also
# safe to be visible in the browser. Access is controlled separately by
# who is signed in and the database's row-level security rules — not by
# keeping this key secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service role" key. This one is NOT safe to expose — it bypasses
# all row-level security rules. It must only ever be used in server-side
# code (never sent to the browser). Required for the admin-only "add a
# staff account" feature (Settings > Staff) to work — without it, that
# page will show an error when creating a new account. Find it on the
# Supabase project's Settings > API page.
SUPABASE_SERVICE_ROLE_KEY=

# The one official web address staff use for the app, including
# "https://" -- for example https://crm.bikurcholimcleveland.org
# Used for links in password-reset and task-reminder emails and for the
# installable home-screen app. Set it in Vercel under Settings >
# Environment Variables (Production). Leave blank for local development.
NEXT_PUBLIC_SITE_URL=

# Optional. Set to "true" (Production only) once the custom domain above
# is working, to automatically send anyone who opens the app on the
# *.vercel.app address over to the official domain instead.
REDIRECT_TO_CANONICAL_DOMAIN=

# --- Task emails ---------------------------------------------------------
# Staff get two kinds of task email:
#   1. Instantly, when someone assigns them a task ("New task: ...").
#   2. A morning summary (about 8am Cleveland time, Sunday-Friday -- none
#      on Shabbos) of their tasks that are due today or overdue.
# Both are sent through Resend (resend.com). Until RESEND_API_KEY is set,
# no emails are sent and nothing else is affected.

# Secret API key from resend.com > API Keys. Keep private.
RESEND_API_KEY=

# The "From" address on task emails, e.g.
#   Bikur Cholim CRM <crm@bikurcholimcleveland.org>
# The domain must first be verified in Resend (Domains page). Until it
# is, leave blank: Resend's test sender is used, which can only deliver
# to the email address that owns the Resend account.
TASK_REMINDER_FROM_EMAIL=

# Any long random password. Vercel sends it automatically with each
# scheduled run so outsiders can't trigger the morning email themselves.
CRON_SECRET=
